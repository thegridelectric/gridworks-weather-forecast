# Copy to .env (gitignored) and fill in.
# Settings use GWWF_ prefix; nested fields use __ delimiter.

# Rabbit broker URL — amqp:// for non-TLS, amqps:// for TLS.
GWWF_RABBIT__URL=amqp://smqPublic:smqPublic@localhost:5672/d1__1

# Routable service alias — MUST match the g.node.gt JSON identity file's
# Alias (GridworksActor enforces the binding at boot).
GWWF_SERVICE_ALIAS=d1.weather

# g.node.gt JSON identity file (sema `g.node.gt` type).
GWWF_G_NODE_PATH=/Users/jessica/GridWorks/gridworks-weather-forecast/g_node.json

GWWF_LOG_LEVEL=INFO

# gnr's public read façade. The actor re-reads its alias by GNodeId before
# each reconnect, so a registry rename converges without a redeploy. Unset
# turns that off (a dev rung with no gnr); the actor says so at boot.
# GWWF_GNR_URL=https://gnr.electricity.works

# The minter (`gwwf create`) connects as its own Service principal. Against
# a gated broker name its broker client and cert here; leave unset against
# a dev broker and the minter uses the actor's client above.
# GWWF_MINTER_RABBIT__URL=amqps://<broker>:5671/<universe>__<run>
# GWWF_MINTER_RABBIT__TLS__CA_CERT_PATH=/path/to/certs/ca.crt
# GWWF_MINTER_RABBIT__TLS__CERT_PATH=/path/to/certs/weather-minter.crt
# GWWF_MINTER_RABBIT__TLS__PRIVATE_KEY_PATH=/path/to/certs/weather-minter.pem
