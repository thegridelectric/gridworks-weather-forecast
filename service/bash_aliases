# gwwf convenience aliases — pure spelling over systemctl/tail, no
# logic. Sourced from the box login's ~/.bashrc; the sudoers drop-in
# (/etc/sudoers.d/weather) grants exactly the systemctl invocations
# below, one unit per command (sudoers matches exact argv — a single
# call naming both units would NOT match the per-unit grants).
#
# The two units log differently: weather-rabbit is a gwbase actor with
# a GNode identity, so it has the bijective file logger (rabbitlog);
# weather-api is a plain FastAPI/uvicorn process with no actor
# identity, so its output is journald-only (apilog).

alias weatherstart='sudo systemctl start weather-rabbit && sudo systemctl start weather-api'
alias weatherstop='sudo systemctl stop weather-rabbit && sudo systemctl stop weather-api'
alias weatherrestart='sudo systemctl restart weather-rabbit && sudo systemctl restart weather-api'
alias weatherstatus='systemctl status weather-rabbit weather-api --no-pager'

alias rabbitlog='cd "$HOME"/.local/state/gridworks/weather-forecast/log && tail -F *.log'
alias apilog='journalctl -u weather-api -f'
