# Dev settings for scripts/dev-up.sh: the local gw-dev-rabbit broker
# (gridworks-base arm.sh / x86.sh) and the compose Postgres. Exported
# before gwwf starts, so the repo's .env never applies in a dev run.
GWWF_RABBIT__URL=amqp://smqPublic:smqPublic@localhost:5672/d1__1
GWWF_SERVICE_ALIAS=d1.weather
GWWF_MY_SUPER_ALIAS=d1.super
GWWF_MY_TIME_COORDINATOR_ALIAS=d1.time
GWWF_LOG_LEVEL=INFO
GWWF_DB_URL=postgresql+psycopg://gwwf:gwwfpass@localhost:5436/gwwf
